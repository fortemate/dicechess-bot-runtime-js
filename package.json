{
  "name": "@fortemate/dicechess-bot-runtime",
  "version": "0.1.0-alpha.1",
  "description": "Portable authenticated Dice Chess webhook runtime for TypeScript.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fortemate/dicechess-bot-runtime-js.git"
  },
  "engines": {
    "node": ">=22.23.3 <23 || >=24.21.0 <25 || >=26.8.2 <27"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next",
    "registry": "https://registry.npmjs.org/"
  },
  "homepage": "https://github.com/fortemate/dicechess-bot-runtime-js#readme",
  "bugs": "https://github.com/fortemate/dicechess-bot-runtime-js/issues",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prebuild": "node scripts/clean-build.mjs",
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check",
    "typecheck": "tsc -p tsconfig.types.json",
    "test:node": "node --test tests/*.test.mjs",
    "test:deno": "deno test --no-config --no-npm --cached-only --allow-read=fixtures,dist,package.json tests/contract.test.mjs tests/auth.test.mjs tests/handler.test.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check": "npm run format:check && npm run build && npm run typecheck && npm run test:node && npm run test:deno && npm run check:package"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "prettier": "3.9.9",
    "typescript": "7.0.2"
  }
}
